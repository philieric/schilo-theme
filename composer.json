{
    "name": "philieric/schilo-theme",
    "description": "Thème WordPress principal de Schilo.org",
    "type": "wordpress-theme",
    "license": "proprietary",
    "authors": [
        {
            "name": "Eric Philippot",
            "email": "philieric@msn.com"
        }
    ],
    "require": {
        "composer/installers": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "brain/monkey": "^2.6"
    },
    "autoload": {
        "psr-4": {
            "Schilo\\Builder\\": "inc/builder/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Schilo\\Builder\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true
        }
    }
}
